{
  "problemMatcher": [
    {
      "owner": "stylelint-unix",
      "pattern": [
        {
          "regexp": "^(.+):(\\d+):(\\d+):\\s*(.+)\\s+\\[(error|warning)\\]\\s*$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4,
          "severity": 5
        }
      ]
    }
  ]
}
