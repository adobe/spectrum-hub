{
  "props": [
    {
      "property": "children",
      "type": "ReactNode",
      "required": true,
      "description": "The ColorSwatches within the ColorSwatchPicker."
    },
    {
      "property": "density",
      "type": "\"compact\" | \"regular\" | \"spacious\"",
      "default": "'regular'",
      "description": "The amount of padding between the swatches."
    },
    {
      "property": "size",
      "type": "\"XS\" | \"S\" | \"M\" | \"L\"",
      "default": "'M'",
      "description": "The size of the color swatches."
    },
    {
      "property": "rounding",
      "type": "\"none\" | \"default\" | \"full\"",
      "default": "'none'",
      "description": "The corner rounding of the color swatches."
    },
    {
      "property": "value",
      "type": "string | Color",
      "description": "The current value (controlled).",
      "inheritedFrom": "ValueBase"
    },
    {
      "property": "defaultValue",
      "type": "string | Color",
      "description": "The default value (uncontrolled).",
      "inheritedFrom": "ValueBase"
    },
    {
      "property": "onChange",
      "type": "(value: Color) => void",
      "description": "Handler that is called when the value changes.",
      "inheritedFrom": "ValueBase"
    },
    {
      "property": "styles",
      "type": "StylesProp",
      "description": "Spectrum-defined styles, returned by the `style()` macro.",
      "inheritedFrom": "StyleProps"
    },
    {
      "property": "slot",
      "type": "string",
      "description": "A slot name for the component. Slots allow the component to receive props from a parent\ncomponent. An explicit `null` value indicates that the local props completely override all\nprops received from a parent.",
      "inheritedFrom": "SlotProps"
    }
  ],
  "status": "stable"
