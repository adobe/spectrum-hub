# Local deploy configuration for the website-lambda scripts.
#
# Copy this to `deploy.env` and fill in your account-specific values:
#   cp deploy.env.example deploy.env
# `deploy.env` is gitignored, so nothing account-specific gets committed.
# deploy.sh and setup-preview-distribution.sh source it automatically if present.

# IAM execution role ARN for the Lambda. Required by deploy.sh (used only when
# the function is first created; updates ignore it).
export LAMBDA_ROLE_ARN="arn:aws:iam::<ACCOUNT_ID>:role/service-role/<ROLE_NAME>"

# The Lambda Function URL host. Required by setup-preview-distribution.sh.
# Get it with:
#   aws lambda get-function-url-config --function-name website-lambda-hello-world \
#     --query FunctionUrl --output text
export ORIGIN_DOMAIN="<FUNCTION_URL_HOST>.lambda-url.us-east-2.on.aws"

# Optional overrides (defaults shown):
# export AWS_PROFILE="spectrumHub"
# export AWS_REGION="us-east-2"
# export FUNCTION_NAME="website-lambda-hello-world"
