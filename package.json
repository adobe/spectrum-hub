{
  "name": "spectrum-hub",
  "version": "1.0.0",
  "type": "module",
  "description": "Powerfully simple experiences.",
  "scripts": {
    "lint:js": "eslint .",
    "lint:css": "stylelint blocks/**/*.css styles/*.css",
    "lint": "npm run lint:js && npm run lint:css",
    "test": "npm run test:unit; e1=$?; npm run test:extractions; e2=$?; exit $((e1 | e2))",
    "test:unit": "wtr --config ./web-test-runner.config.mjs --node-resolve --port=2000 --coverage --concurrent-browsers 4",
    "test:extractions": "node --test test/extractions/*.node.test.js test/indexer/*.node.test.js",
    "test:watch": "npm run test:unit -- --watch",
    "test:file": "wtr --node-resolve --port=2000 --coverage",
    "test:file:watch": "wtr --config ./web-test-runner.config.mjs --node-resolve --port=2000 --coverage --watch",
    "test:a11y": "playwright test",
    "build:lit": "esbuild --format=esm --minify ./deps/lit/src/index.js --bundle --outfile=./deps/lit/dist/index.js",
    "build:turndown": "esbuild --format=esm --minify ./deps/turndown/src/index.js --bundle --outfile=./deps/turndown/dist/index.js",
    "build:swc-tooltip": "esbuild --format=esm --minify ./deps/components/swc-tooltip/src/index.js --bundle --outfile=./deps/components/swc-tooltip/dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adobe/spectrum-hub.git"
  },
  "author": "Adobe",
  "license": "Apache License 2.0",
  "bugs": {
    "url": "https://github.com/adobe/spectrum-hub/issues"
  },
  "homepage": "https://github.com/adobe/spectrum-hub#readme",
  "devDependencies": {
    "@adobe/aem-cli": "^16.20.9",
    "@adobe/eslint-config-helix": "^3.0.17",
    "@axe-core/playwright": "^4.11.3",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@web/dev-server-import-maps": "^0.3.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "1.0.0",
    "chai": "6.2.2",
    "eslint": "^9.39.2",
    "eslint-plugin-chai-friendly": "^1.1.0",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^17.0.0",
    "sinon": "^21.0.1",
    "stylelint": "^17.1.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "dependencies": {
    "@adobe/spectrum-wc": "2.0.0-beta.0",
    "@playwright/test": "^1.60.0",
    "algoliasearch": "^5.56.0",
    "esbuild": "^0.28.0",
    "lit": "^3.3.1",
    "node-html-parser": "^9.0.1",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
